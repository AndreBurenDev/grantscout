# infra/mini/env.example → copy to /etc/grantscout/env inside the machine (root:root 0600).
# Exactly the variables src/core/config.ts reads. Placeholders only: no paid AI or scraping key exists or is read.
# Plain KEY=value lines (systemd EnvironmentFile: no quotes, no `export`).

NODE_ENV=production
DATA_DIR=/var/lib/grantscout
CONSOLE_STATIC_DIR=/opt/grantscout/console/dist
# CONSOLE_PORT=3300

# --- required in production (the service refuses to start without them) ---
# Unix socket `tailscale serve` forwards to (README step 3). The Console trusts a tailnet login only on requests
# that arrive here; the TCP port answers the key-authenticated health pull and nothing else under /api.
CONSOLE_PROXY_SOCKET=/run/grantscout/console.sock
CONSOLE_ALLOWLIST=<your tailnet login, comma-separated for more>
# Shared secret for GET /api/ops/health (X-API-Key). Generate: openssl rand -hex 32
# The same value goes into the host's ~/.config/grantscout/ops-key.
OPS_KEY=<openssl rand -hex 32>

# First boot: keep the scheduler PAUSED until smoke is green. Paused = the API and Console run, but no scheduled
# or Console-triggered run starts (the CLI still works). Set to false and restart to start scheduling.
SCHEDULER_PAUSED=true

# --- local AI (optional; unset = keyword-mock Fit scores and no website mission extraction) ---
# The Mini host's tailnet IP, served into the machine by the host-side socat relay (ai.grantmaster.ollama-tailnet).
OLLAMA_BASE_URL=http://<mini-tailnet-ip>:11434
LLM_MODEL=<an ollama model tag, e.g. the one GrantAtlas uses>
# An ollama EMBEDDING model. Leave empty until one is pulled on the host; Fit then uses the keyword mock.
EMBED_MODEL=
# LLM_TIMEOUT_MS=120000

# --- GrantAtlas read access (optional; unset = the committed sample files) ---
# Awardee/applicant list: URL of a JSON array. Opportunities: URL of a JSON array or { grants: [...] }.
# file:// URLs read a local export. The key, when set, is sent as a Bearer token.
GRANTATLAS_READ_API_URL=
GRANTATLAS_GRANTS_API_URL=
GRANTATLAS_API_KEY=

# --- HubSpot (optional; dry-run unless explicitly enabled) ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_SYNC_ENABLED=false
