# Local development. Production values live in /etc/grantscout/env inside the machine (see infra/mini/env.example).
# Everything is optional: with nothing set, data goes to ./.data, Fit uses the keyword mock and the sources read
# the committed samples.

# DATA_DIR=.data
# CONSOLE_PORT=3300
# Development only: act as this user without a tailnet proxy (`npm run dev` sets it). Ignored in production.
# DEV_AUTH_EMAIL=dev@localhost

# Local AI through Ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=
# EMBED_MODEL=

# GrantAtlas read access
# GRANTATLAS_READ_API_URL=
# GRANTATLAS_GRANTS_API_URL=
# GRANTATLAS_API_KEY=

# HubSpot (dry-run unless explicitly enabled)
# HUBSPOT_ACCESS_TOKEN=
HUBSPOT_SYNC_ENABLED=false
